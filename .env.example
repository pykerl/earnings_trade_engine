# Copy to .env (gitignored) and fill in. scripts/cron_daily.sh sources this.

# Alpha Vantage free key -- backfill drip (25 calls/day). Never commit real keys.
ALPHAVANTAGE_API_KEY=

# Optional: Finnhub free key for a third earnings-calendar cross-check source.
FINNHUB_API_KEY=

# FTPS publish of the dashboard at the end of `make daily`.
# Needs outbound port 21 -- works from a normal machine, not from cloud sandboxes.
ETE_UPLOAD_HOST=ftp.pyktech.com
ETE_UPLOAD_USER=
ETE_UPLOAD_PASSWORD=
ETE_UPLOAD_DIR=domains/paulkerl.com/public_html/earnings
ETE_UPLOAD_PROTOCOL=ftps
ETE_UPLOAD_PORT=21

# Set to 0 to stop the cron script from committing/pushing log/predictions.csv.
ETE_GIT_PUSH_LOG=1
