# Copy to .env (gitignored) and fill in. scripts/cron_daily.sh sources this.

# Alpha Vantage free key -- backfill drip (25 calls/day). Never commit real keys.
ALPHAVANTAGE_API_KEY=

# Optional: Finnhub free key for a third earnings-calendar cross-check source.
FINNHUB_API_KEY=

# GitHub Pages publish (default): cron_daily.sh pushes the latest dashboard
# to the gh-pages branch -> https://pykerl.github.io/earnings_trade_engine/
ETE_PUBLISH_PAGES=1

# Optional FTPS publish instead/as well (needs outbound port 21; leave HOST
# empty to disable).
ETE_UPLOAD_HOST=
ETE_UPLOAD_USER=
ETE_UPLOAD_PASSWORD=
ETE_UPLOAD_DIR=
ETE_UPLOAD_PROTOCOL=ftps
ETE_UPLOAD_PORT=21

# Set to 0 to stop the cron script from committing/pushing log/predictions.csv.
ETE_GIT_PUSH_LOG=1
